# Bodhan AI API Credentials (Required for speech, translation, and transcription)
BODHAN_TRANSCRIBE_KEY=your_bodhan_transcribe_key_here
BODHAN_TRANSLATE_KEY=your_bodhan_translate_key_here
BODHAN_SPEAK_KEY=your_bodhan_speak_key_here
BODHAN_OCR_KEY=your_bodhan_ocr_key_here

# Optional Bodhan Base URL override (defaults to https://api.bodhan.ai/v1)
# BODHAN_BASE_URL=https://api.bodhan.ai/v1

# OpenAI-Compatible LLM Credentials (Used ONLY for English editing, back-translation judging, glossary extraction)
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_llm_api_key_here
